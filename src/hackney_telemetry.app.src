{application, hackney_telemetry, [
    {description, "Telemetry for hackney requests and connection pools"},
    {vsn, "1.0.0"},
    {registered, []},
    {mod, {hackney_telemetry_app, []}},
    {applications, [kernel, stdlib, telemetry, hackney]},
    {env, [{report_interval, 1000}]},
    {modules, []},
    {licenses, ["Apache 2.0"]},
    {links, [{"Github", "https://github.com/msramos/hackney_telemetry"}]},
    {files, [
        "src",
        "rebar.config",
        "rebar.lock",
        "CHANGELOG.md",
        "CODE_OF_CONDUCT.md",
        "README.md",
        "LICENSE",
        "NOTICE"
    ]}
]}.
